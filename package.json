{
  "name": "controlled-substance-licence",
  "version": "1.0.0",
  "description": "Controlled Substance Licence",
  "main": "index.js",
  "engines": {
    "node": ">=24.21.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "[ -f .env ] && hof-build watch --env || hof-build watch",
    "build": "hof-build",
    "postinstall": "hof-build",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:smoke": "bddgen && playwright test --grep @CslRegression",
    "test:e2e:typecheck": "tsc --noEmit",
    "test:e2e:headed": "bddgen && playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/controlled-substance-licence.git"
  },
  "author": "HOF",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/controlled-substance-licence/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/controlled-substance-licence#readme",
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "bl": "^6.1.6",
    "busboy": "^1.6.0",
    "crypto-random-string": "^6.0.0",
    "date-fns": "^4.4.0",
    "form-data": "^4.0.6",
    "hof": "~24.5.0",
    "notifications-node-client": "^8.4.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-hof": "^1.3.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "1.64.1",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "brace-expansion": "^5.0.9",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.3.2",
    "morgan": "^1.12.0",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2",
    "tar": "^7.5.21",
    "undici": "^8.9.0"
  }
}